[Unit]
Description=Temporal web UI (port 8233)
Requires=temporal-server.service
After=temporal-server.service

[Service]
User=temporal
Group=temporal
WorkingDirectory=/var/lib/temporal
ExecStart=/usr/local/bin/temporal-ui-server --root /etc/temporal/ui --env production start
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/temporal

[Install]
WantedBy=multi-user.target
