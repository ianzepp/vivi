#!/usr/bin/env bash
# Verification rungs for vivi: task (cheapest), need, main (widest).
set -euo pipefail

# Stopgap for need f1aa4d4c: a few lock tests fail at random under the
# parallel suite. A failing test run is run once more; a real regression
# fails twice. Remove when f1aa4d4c lands.
twice() { "$@" || { echo "rung: retrying once (f1aa4d4c lock flakes)" >&2; "$@"; }; }

case "${1:-}" in
  task)
    cargo fmt --check
    cargo check --all-targets --quiet
    cargo test --test hygiene --quiet
    ;;
  need)
    cargo fmt --check
    twice cargo test --lib --quiet
    cargo test --test hygiene --quiet
    ;;
  main)
    twice cargo test --quiet
    ;;
  *)
    echo "usage: scripts/rung task|need|main" >&2
    exit 2
    ;;
esac
